<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SpeakerKeepAwake</RootNamespace>
    <AssemblyName>SpeakerKeepAwake</AssemblyName>
    <Product>Speaker Keep Awake</Product>
    <Description>Mantém uma saída Bluetooth acordada durante pausas curtas de áudio.</Description>
    <Version>2.3.6</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>
</Project>
